FROM php:8.3-cli-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libonig-dev libpng-dev libjpeg62-turbo-dev libwebp-dev libicu-dev && docker-php-ext-configure gd --with-jpeg --with-webp && docker-php-ext-install pdo_mysql mbstring gd intl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
